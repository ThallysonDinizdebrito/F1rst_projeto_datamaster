{
  "type": "object",
  "properties": {
    "ItemID": { "type": "string", "pattern": "^I\\d{6}$" },
    "nome": { "type": "string", "minLength": 1 },
    "categoria": { "type": "string", "enum": ["Hamburguer","Pizza","Comida Japonesa","Bebida","Sobremesa"] },
    "preco": { "type": "number", "minimum": 0 },
    "MerchantID": { "type": "string", "pattern": "^R\\d{6}$" }
  },
  "required": ["ItemID", "nome", "categoria", "preco", "MerchantID"]
}

