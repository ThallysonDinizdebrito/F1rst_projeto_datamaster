{
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "nome": { "type": "string", "minLength": 3 },
    "email": { "type": "string", "format": "email" },
    "telefone": { "type": "string", "pattern": "^\\(\\d{3}\\)\\d{3}-\\d{4}$" },
    "endereco": { "type": "string" },
    "idade": { "type": "integer", "minimum": 0, "maximum": 120 },
    "criado_em": { "type": "string", "format": "date-time" }
  },
  "required": ["nome", "email"]
}
