{
  "type": "object",
  "properties": {
    "PedidoID": { "type": "string", "pattern": "^P\\d{6}$" },
    "ClientID": { "type": "string", "pattern": "^C\\d{6}$" },
    "DriversID": { "type": "string", "pattern": "^D\\d{6}$" },
    "MerchantID": { "type": "string", "pattern": "^R\\d{6}$" },
    "Produtos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ItemID": { "type": "string", "pattern": "^I\\d{6}$" },
          "quantidade": { "type": "integer", "minimum": 1 },
          "preco": { "type": "number", "minimum": 0 }
        },
        "required": ["ItemID", "quantidade", "preco"]
      }
    },
    "valor_total": { "type": "number", "minimum": 0 },
    "tipo_pagamento": { "type": "string", "enum": ["PIX", "CARTAO CREDITO", "CARTAO DEBITO", "VOUCHER"] }
  },
  "required": ["PedidoID", "ClientID", "DriversID", "MerchantID", "Produtos", "valor_total", "tipo_pagamento"]
}

