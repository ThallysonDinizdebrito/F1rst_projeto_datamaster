{
  "type": "object",
  "properties": {
    "DriversID": { "type": "string", "pattern": "^D\\d{6}$" },
    "nome": { "type": "string", "minLength": 3 },
    "endereco": { "type": "string" },
    "veiculo": { "type": "string", "enum": ["moto","carro","bicicleta"] },
    "placa": { "type": "string", "pattern": "^[A-Z]{3}-\\d{4}$" }
  },
  "required": ["DriversID", "nome", "veiculo", "placa"]
}
